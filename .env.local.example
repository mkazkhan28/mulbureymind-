# =============================================================================
# BDS Study Hub - Environment Variables Template
# Free tier on Supabase (PostgreSQL & Auth)
# =============================================================================

# Project URL from Supabase Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (KEEP PRIVATE - Never share or commit to Git)
# Used only on the server for admin operations & webhook signature validation
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Pakistan Merchant Gateway (Stage 7 - JazzCash / Easypaisa Sandbox)
NEXT_PUBLIC_PAYMENT_ENVIRONMENT=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
